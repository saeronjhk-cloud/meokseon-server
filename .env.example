# 먹선 서버 환경변수
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meokseon
DB_USER=meokseon_app
DB_PASSWORD=your_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10

# API
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100

# ============================================================
# Supabase 인증 (★ 세션64c · 제이 확정 2026-08-24 — 통합앱 인증으로 전환)
# ============================================================
# 통합앱(영양공식·NutriLens·먹선)이 공유하는 Supabase Auth 로
# `Authorization: Bearer <access token>` 을 검증한다.
#
# ★★ 필수는 SUPABASE_URL 하나다. SUPABASE_JWT_SECRET 은 «전환기 폴백»이라 선택이다.
#
# ⚠ 세션64c 첫 판이 「이 프로젝트는 HS256(대칭키)」라고 적었는데 **틀렸다.**
#   그 근거는 anon key 를 디코드한 것이었는데, anon key 는 프로젝트 API 키이지
#   사용자 세션 토큰이 아니다. 둘은 다른 키로 서명된다.
#   실측(2026-08-25): 대시보드 Settings → JWT Keys 에
#     「Legacy JWT secret has been migrated to new JWT Signing Keys」 배너,
#     CURRENT KEY 타입 = ECC (P-256), 공개 JWKS 의 keys[0].alg = "ES256".
#   → 지금 발급되는 access token 은 **ES256** 이다.
#   확인하는 법(비밀 불필요):
#     curl https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- ① 주 경로: ES256 + JWKS (필수) ---
# 서버가 `<이 값>/auth/v1/.well-known/jwks.json` 을 «조립»해 공개키를 가져온다.
# 값 자체는 비밀이 아니다(앱 번들에도 들어간다). 앱의 VITE_SUPABASE_URL 과 같은 값이어야 한다.
# 어디서 얻나: Supabase Dashboard → Project Settings → Data API → Project URL
# ⚠ 반드시 https. (평문 http 는 루프백 주소에서만 허용된다 — 테스트용)
SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_URL 대신 ref 만 줘도 된다. 위 값이 있으면 이 값은 무시된다.
# SUPABASE_PROJECT_REF=your-project-ref

# --- ② 폴백: legacy HS256 (선택) ---
# 전환 «이전»에 발급돼 아직 만료되지 않은 세션 토큰이 HS256 일 수 있다.
# 대시보드가 legacy secret 을 「still used / only verify」로 표시하는 동안만 의미가 있다.
# 이 값이 **비어 있으면 폴백을 아예 시도하지 않는다** — ES256 만으로 정상 동작한다.
# 어디서 얻나: Supabase Dashboard → Settings → JWT Keys → Legacy JWT Secret
#   (anon key·service_role key 가 **아니다** — 그 둘은 이 비밀로 서명된 «공개» 토큰이라
#    서버에 넣을 값이 아니다. anon key 를 Bearer 로 보내면 서버가 401 로 거부한다.)
# ⚠ 보관: Railway 환경변수만. git commit 금지. 여기에 실제 값을 적지 말 것.
SUPABASE_JWT_SECRET=

# ⚠ 배포 순서: ① scripts/migrations/021_supabase_auth.sql 적용
#              ② 위 환경변수 추가  ③ 그 «다음»에 코드 배포
#   순서가 어긋나도 500 이 아니라 503 이 난다:
#     AUTH_NOT_CONFIGURED   — SUPABASE_URL·SUPABASE_JWT_SECRET 이 둘 다 없다
#     AUTH_KEYS_UNAVAILABLE — JWKS 를 가져오지 못했고 캐시도 없다 (Supabase 장애·방화벽)
#     AUTH_STORE_NOT_READY  — 021 마이그레이션 미적용
#   401 은 두 가지뿐이다: AUTH_REQUIRED(토큰 없음) / AUTH_INVALID(위조·만료·sub 없음).
# ⚠ Railway 아웃바운드에서 `<ref>.supabase.co` 로 나가는 HTTPS 가 막혀 있으면
#   인증이 전부 503 이 된다. JWKS 는 «서버가 밖으로 나가는» 첫 호출이다.

# Firebase Admin SDK (Service Account JSON 통째)
# ⚠ 세션64c — 라우트는 전부 Supabase 인증으로 옮겼다. 이 값은 전환 기간 잔존물이다
#   (`src/middleware/firebaseAuth.js` 는 아직 지우지 않았다).
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# → JSON 내용 통째로 한 줄로 (escape 처리 필요할 수 있음).
# 보관: Railway 환경변수만. git commit 금지.
# 로컬 개발 시 .env.local (gitignore 됨)에 저장 가능.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","..."}

# Railway DB
DATABASE_URL=postgresql://user:password@host:port/dbname

# data.go.kr auth key (Decoding)
DATA_GO_KR_KEY=your-data-go-kr-key
FOODSAFETY_API_KEY=your_foodsafetykorea_key
